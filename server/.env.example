# Compose does not publish Postgres, so this URL is not the compose database.
# Mint a dev token inside the api container:
#   docker compose exec api node dist/auth/print-token.js <phone>
DATABASE_URL=postgres://food:food@localhost:5432/food
PORT=3000
JWT_SECRET=dev-secret-change-me
OTP_DEV_MODE=true
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
